/*
this script create a data base named 'DataWarehouse' 
and creating theee schemas named 'bronze','silver','gold'

this script will check if DataWarehouse is exestis or not and will drop it if it's already available 
*/

--drop and recreate 'DataWarehouse'
use master 
go
if exists (select * from sys.databases where name='DataWarehouse' )
begin 
 drop database DataWarehouse
end 
go
--create datawarehouse
create database DataWarehouse 
go 
--create schema
use DataWarehouse
go 
create schema bronze;  
go
create schema silver;
go
create schema gold ;
go
